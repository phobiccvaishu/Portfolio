# Server Configuration
PORT=5000
NODE_ENV=development

# Administrator Authentication
# Replace with your desired admin credentials
ADMIN_USERNAME=vaishnavi
ADMIN_PASSWORD=change_this_to_a_secure_password_in_production

# Optional: Pre-hashed password (salt:hash format). If set, this takes precedence over ADMIN_PASSWORD.
# Generate using Node: node -e "const c=require('crypto'), s=c.randomBytes(16).toString('hex'), h=c.pbkdf2Sync('YOUR_PASSWORD',s,100000,64,'sha512').toString('hex'); console.log(s+':'+h);"
# ADMIN_PASSWORD_HASH=

# Cryptographic Session Secret (required in production for token signing)
# Generate a random 64-character secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=dev_session_secret_replace_with_random_hex_in_production
